{
  "name": "secureplan-surveyor",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/**/*.test.js",
    "check": "npm run build && npm test",
    "native:sync": "vite build --mode native && cap sync",
    "native:ios": "npm run native:sync && cap open ios",
    "native:android": "npm run native:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.112.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "vite": "^8.2.0"
  }
}
