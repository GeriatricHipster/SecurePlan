PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
# Set this before exposing an empty installation to the public internet.
SETUP_CODE=
DATA_DIR=./data
# Leave these blank for local SQLite/file development. Production uses all four.
DATABASE_URL=
DATABASE_SSL=true
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=secureplan-files
APP_ORIGIN=http://localhost:5173
# Comma-separated origins allowed to use native bearer authentication.
# These are the default iOS and Android Capacitor origins used by this project.
# Leave blank if you only run SecurePlan in a web browser.
# For native development/builds, use: capacitor://localhost,https://localhost
MOBILE_ORIGINS=
TRUST_PROXY=false
COOKIE_SECURE=false
MIN_FREE_STORAGE_BYTES=1048576
